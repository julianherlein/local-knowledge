# Where knowledge converges: concepts and entities ranked by how many pages link to them.
# Generated by `kb init`; safe to edit in Obsidian.
# Note from the docs: file.backlinks is performance heavy and does not refresh automatically
# when the vault changes; reopen the base to recount.
# Provenance of the syntax used here (checked 2026-09):
#   Official docs, https://help.obsidian.md/bases/syntax : file.backlinks, formulas, limit.
#   Official docs, https://help.obsidian.md/bases/functions : file.inFolder, file.hasTag, list,
#     list.length.
#   NOT in the help pages, taken from .base files Obsidian itself wrote
#   (github.com/kepano/kepano-obsidian, Templates/Bases) and community usage:
#     the view-level `sort` list of {property, direction}, sorting by a formula property.
filters:
  and:
    - file.inFolder("wiki")
formulas:
  backlinks: file.backlinks.length
  source_count: list(sources).length
properties:
  file.name:
    displayName: Page
  formula.backlinks:
    displayName: Backlinks
  formula.source_count:
    displayName: Sources
views:
  - type: table
    name: Concepts by backlinks
    filters:
      and:
        - file.hasTag("concept")
    order:
      - file.name
      - formula.backlinks
      - formula.source_count
      - domains
    sort:
      - property: formula.backlinks
        direction: DESC
    limit: 50
  - type: table
    name: Entities by backlinks
    filters:
      and:
        - file.hasTag("entity")
    order:
      - file.name
      - formula.backlinks
      - formula.source_count
      - domains
    sort:
      - property: formula.backlinks
        direction: DESC
    limit: 50
  - type: table
    name: Most-sourced concepts
    filters:
      and:
        - file.hasTag("concept")
    order:
      - file.name
      - formula.source_count
      - formula.backlinks
      - domains
    sort:
      - property: formula.source_count
        direction: DESC
    limit: 50
