# Every source summary not yet compiled, across all domains: a structured view over
# wiki/_compile-queue.md. Generated by `kb init`; safe to edit in Obsidian.
# Provenance of the syntax used here (checked 2026-09):
#   Official docs, https://help.obsidian.md/bases/syntax : filters, formulas, groupBy,
#     list indexing (list[0]), subtracting dates.
#   Official docs, https://help.obsidian.md/bases/functions : file.inFolder, list, today.
#   NOT in the help pages, taken from .base files Obsidian itself wrote
#   (github.com/kepano/kepano-obsidian, Templates/Bases) and community usage:
#     the view-level `sort` list of {property, direction}, and `.days` on a date difference.
#   Unverified: grouping by a formula property (formula.primary_domain). The docs allow
#     formulas wherever properties go, but no Obsidian-written example groups by one; if the
#     view shows a single group, change groupBy to `domains`.
filters:
  and:
    - file.inFolder("wiki/sources")
    - 'status == "uncompiled"'
formulas:
  primary_domain: list(domains)[0]
  age_days: (today() - captured).days
properties:
  file.name:
    displayName: Source
  formula.primary_domain:
    displayName: Primary domain
  formula.age_days:
    displayName: Days waiting
views:
  - type: table
    name: By domain
    groupBy:
      property: formula.primary_domain
      direction: ASC
    order:
      - file.name
      - source_type
      - captured
      - formula.age_days
      - domains
    sort:
      - property: captured
        direction: ASC
  - type: table
    name: Oldest first
    order:
      - file.name
      - formula.primary_domain
      - source_type
      - captured
      - formula.age_days
    sort:
      - property: captured
        direction: ASC
