# Every source summary not yet compiled, across all domains: a structured view over
# wiki/_compile-queue.md. Generated by `kb init`; safe to edit in Obsidian.
# Syntax checked against the official Bases docs (2026-09):
#   https://help.obsidian.md/bases/syntax     (filters, formulas, groupBy, list indexing, date arithmetic)
#   https://help.obsidian.md/bases/functions  (file.inFolder, list, today)
# `sort` shape taken from .base files written by Obsidian (github.com/kepano/kepano-obsidian).
filters:
  and:
    - file.inFolder("wiki/sources")
    - 'status == "uncompiled"'
formulas:
  primary_domain: list(domains)[0]
  age_days: (today() - captured).days
properties:
  file.name:
    displayName: Source
  formula.primary_domain:
    displayName: Primary domain
  formula.age_days:
    displayName: Days waiting
views:
  - type: table
    name: By domain
    groupBy:
      property: formula.primary_domain
      direction: ASC
    order:
      - file.name
      - source_type
      - captured
      - formula.age_days
      - domains
    sort:
      - property: captured
        direction: ASC
  - type: table
    name: Oldest first
    order:
      - file.name
      - formula.primary_domain
      - source_type
      - captured
      - formula.age_days
    sort:
      - property: captured
        direction: ASC
