# Sources captured in the last 14 days. Generated by `kb init`; safe to edit in Obsidian.
# `captured` is typed as a date in .obsidian/types.json, which makes the comparison below a
# date comparison (a text-typed property would not compare against today() - "14d").
# Provenance of the syntax used here (checked 2026-09):
#   Official docs, https://help.obsidian.md/bases/syntax : date arithmetic (today() - "14d"),
#     groupBy, list indexing.
#   Official docs, https://help.obsidian.md/bases/functions : file.inFolder, list, today.
#   NOT in the help pages, taken from .base files Obsidian itself wrote
#   (github.com/kepano/kepano-obsidian, Templates/Bases) and community usage:
#     the view-level `sort` list of {property, direction}.
#   Unverified: grouping by a formula property (view "By domain"); see compile-queue.base.
filters:
  and:
    - file.inFolder("wiki/sources")
    - 'captured >= today() - "14d"'
formulas:
  primary_domain: list(domains)[0]
properties:
  file.name:
    displayName: Source
  formula.primary_domain:
    displayName: Primary domain
views:
  - type: table
    name: By source type
    groupBy:
      property: source_type
      direction: ASC
    order:
      - file.name
      - formula.primary_domain
      - status
      - captured
    sort:
      - property: captured
        direction: DESC
  - type: table
    name: By domain
    groupBy:
      property: formula.primary_domain
      direction: ASC
    order:
      - file.name
      - source_type
      - status
      - captured
    sort:
      - property: captured
        direction: DESC
