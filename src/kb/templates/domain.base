# Pages of the {{DOMAIN}} domain, embedded view by view in [[wiki/domains/{{DOMAIN}}]].
# Generated by `kb init`; safe to edit in Obsidian (kb init never overwrites it).
# Provenance of the syntax used here (checked 2026-09):
#   Official docs, https://help.obsidian.md/bases/syntax : filters (and/or), formulas, views,
#     order, limit, groupBy {property, direction}, subtracting dates.
#   Official docs, https://help.obsidian.md/bases/functions : file.inFolder, file.hasTag, today.
#   Official docs, https://help.obsidian.md/bases/views : embedding one view, ![[file.base#View name]].
#   NOT in the help pages, taken from .base files Obsidian itself wrote
#   (github.com/kepano/kepano-obsidian, Templates/Bases) and community usage:
#     the view-level `sort` list of {property, direction}, and `.days` on a date difference.
filters:
  and:
    - file.inFolder("wiki")
    - file.hasTag("{{DOMAIN}}")
formulas:
  age_days: (today() - captured).days
properties:
  file.name:
    displayName: Page
  formula.age_days:
    displayName: Days waiting
views:
  - type: table
    name: Concepts & entities
    filters:
      or:
        - file.hasTag("concept")
        - file.hasTag("entity")
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - domains
      - aliases
      - updated
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Uncompiled sources
    filters:
      and:
        - file.inFolder("wiki/sources")
        - 'status == "uncompiled"'
    order:
      - file.name
      - source_type
      - captured
      - formula.age_days
      - published
    sort:
      - property: captured
        direction: ASC
  - type: table
    name: Syntheses
    filters:
      and:
        - file.hasTag("synthesis")
    order:
      - file.name
      - question
      - as_of
      - updated
    sort:
      - property: updated
        direction: DESC
  - type: table
    name: Recent sources
    filters:
      and:
        - file.inFolder("wiki/sources")
    order:
      - file.name
      - source_type
      - status
      - captured
    sort:
      - property: captured
        direction: DESC
    limit: 25
