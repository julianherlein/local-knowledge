# Pages of the {{DOMAIN}} domain, embedded view by view in [[wiki/domains/{{DOMAIN}}]].
# Generated by `kb init`; safe to edit in Obsidian (kb init never overwrites it).
# Syntax checked against the official Bases docs (2026-09):
#   https://help.obsidian.md/bases/syntax     (filters, formulas, views, groupBy, date arithmetic)
#   https://help.obsidian.md/bases/functions  (file.inFolder, file.hasTag, list, today)
#   https://help.obsidian.md/bases/views      (embedding a view: ![[file.base#View name]])
# `sort` (list of {property, direction}) is not in the help pages; its shape is taken from
# .base files written by Obsidian itself (github.com/kepano/kepano-obsidian, Templates/Bases).
filters:
  and:
    - file.inFolder("wiki")
    - file.hasTag("{{DOMAIN}}")
formulas:
  age_days: (today() - captured).days
properties:
  file.name:
    displayName: Page
  formula.age_days:
    displayName: Days waiting
views:
  - type: table
    name: Concepts & entities
    filters:
      or:
        - file.hasTag("concept")
        - file.hasTag("entity")
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - domains
      - aliases
      - updated
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Uncompiled sources
    filters:
      and:
        - file.inFolder("wiki/sources")
        - 'status == "uncompiled"'
    order:
      - file.name
      - source_type
      - captured
      - formula.age_days
      - published
    sort:
      - property: captured
        direction: ASC
  - type: table
    name: Syntheses
    filters:
      and:
        - file.hasTag("synthesis")
    order:
      - file.name
      - question
      - as_of
      - updated
    sort:
      - property: updated
        direction: DESC
  - type: table
    name: Recent sources
    filters:
      and:
        - file.inFolder("wiki/sources")
    order:
      - file.name
      - source_type
      - status
      - captured
    sort:
      - property: captured
        direction: DESC
    limit: 25
