#!/bin/sh
# Gate lane: lint + fast tests. Slow (real git) and live (network/LLM) lanes run before shipping:
#   uv run pytest -m "not live"          # everything deterministic
#   uv run python -m evals.run           # paid LLM evals
set -e
uv run ruff check .
uv run ruff format --check .
uv run pytest -q -m "not slow and not live"
